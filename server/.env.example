# Copy this file to server/.env and fill in your LinkedIn app credentials.
# NEVER commit server/.env. Regenerate your client secret if it ever leaks.

LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_regenerated_client_secret_here

# Must match EXACTLY an "Authorized redirect URL" configured in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:5173/api/auth/linkedin/callback

# Where to send the user back after auth (the Vite app).
FRONTEND_URL=http://localhost:5173

PORT=3001
